# Quarto: archivos temporales
.quarto/
**/.quarto/
*_cache/
**/*_cache/

# R
.Rhistory
.RData
.Ruserdata
.Rproj.user/

# Python
.venv/
venv/
__pycache__/
*.py[cod]

# Credenciales y secretos
.env
.env.*
!.env.example
*.env
*.pem
*.key
*.p12
*.pfx
*.kdbx
id_rsa*
id_ed25519*
*credentials*
*secret*
*.token

# Datos institucionales o no publicables
data/raw/**
data/external/**

# Conservar únicamente la estructura de carpetas
!data/raw/.gitkeep
!data/external/.gitkeep

# Productos temporales de las clases
classes/**/*.html
classes/**/*_files/
classes/**/*.pptx
classes/**/*.pdf

# Archivos del sistema
.DS_Store
Thumbs.db
desktop.ini
*.tmp
*.temp
*.bak
*.swp
~$*
